{
  "id": "energy-instrument",
  "forms": [
    "Energy instrument (REC/PPA)"
  ],
  "actor": "ESG_DIRECTOR",
  "readOnlyRole": "AUDITOR",
  "create": {
    "method": "POST",
    "path": "/v1/carbon/instruments"
  },
  "read": {
    "path": "/v1/carbon/instruments/{id}"
  },
  "update": {
    "method": "PUT",
    "path": "/v1/carbon/instruments/{id}",
    "versioned": true
  },
  "isolation": {
    "status": 404
  },
  "values": {
    "orgId": "{ORG_HQ}",
    "instrumentType": "rec",
    "energySource": "solar",
    "mwh": 12.5,
    "emissionFactor": 0,
    "reportingPeriodStart": "{yyyy}-01-02",
    "reportingPeriodEnd": "{yyyy}-12-31",
    "certificateRef": "REC-{u}",
    "supplier": "I-REC Nigeria {u}"
  },
  "changes": {
    "orgId": "{ORG_SITE_1}",
    "instrumentType": "ppa",
    "energySource": "wind",
    "mwh": 20,
    "emissionFactor": 0.012,
    "reportingPeriodStart": "{yyyy}-02-01",
    "reportingPeriodEnd": "{yyyy}-11-30",
    "certificateRef": "PPA-{u}",
    "supplier": "Windco {u}"
  },
  "invalid": [
    {
      "field": "instrumentType",
      "value": "voucher",
      "rule": "enum"
    },
    {
      "field": "energySource",
      "value": "coal",
      "rule": "enum"
    },
    {
      "field": "mwh",
      "value": 0,
      "rule": "> 0"
    },
    {
      "field": "emissionFactor",
      "value": -1,
      "rule": ">= 0"
    },
    {
      "field": "supplier",
      "value": "",
      "rule": "required"
    },
    {
      "field": "certificateRef",
      "value": {
        "$repeat": [
          "x",
          101
        ]
      },
      "rule": "max 100"
    },
    {
      "field": "reportingPeriodEnd",
      "value": "{yyyy}-01-01",
      "rule": "end >= start (cross-field)"
    }
  ],
  "ui": {
    "pending": "filled in with the WP-21 instruments form"
  }
}
