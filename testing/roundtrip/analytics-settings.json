{
  "id": "analytics-settings",
  "forms": [
    "Anomaly sensitivity"
  ],
  "actor": "ESG_DIRECTOR",
  "readOnlyRole": "AUDITOR",
  "singleton": true,
  "read": {
    "path": "/v1/analytics/settings"
  },
  "update": {
    "method": "PUT",
    "path": "/v1/analytics/settings",
    "versioned": true
  },
  "isolation": {
    "status": 403,
    "note": "tenant B's plan doesn't include ESG Analytics"
  },
  "values": {
    "zscoreThreshold": 2.5,
    "iqrK": 2,
    "variancePct": 30,
    "minHistory": 6
  },
  "changes": {
    "zscoreThreshold": 3,
    "iqrK": 1.5,
    "variancePct": 25,
    "minHistory": 4
  },
  "invalid": [
    {
      "field": "zscoreThreshold",
      "value": 6,
      "rule": "2 to 5"
    },
    {
      "field": "iqrK",
      "value": 0.5,
      "rule": "1 to 3"
    },
    {
      "field": "variancePct",
      "value": 2,
      "rule": "5 to 500"
    },
    {
      "field": "minHistory",
      "value": 2,
      "rule": "3 to 20"
    }
  ],
  "ui": {
    "fields": {
      "zscoreThreshold": {
        "label": "Z-score threshold"
      },
      "iqrK": {
        "label": "IQR multiplier"
      },
      "variancePct": {
        "label": "Year-on-year change (%)"
      },
      "minHistory": {
        "label": "Earlier points needed"
      }
    }
  }
}
