  "derived": {
    "category": "E",
    "unit": "L",
    "validationStatus": "draft"
  },
  "invalid": [
    {
      "field": "metricKey",
      "value": "made_up_metric",
      "rule": "catalogue metric"
    },
    {
      "field": "metricKey",
      "value": "",
      "rule": "required"
    },
    {
      "field": "numericValue",
      "value": -5,
      "rule": ">= 0 for this metric"
    },
    {
      "field": "numericValue",
      "value": 1.1234567,
      "rule": "6 decimals"
    },
    {
      "field": "subCategory",
      "value": {
        "$repeat": [
          "x",
          101
        ]
      },
      "rule": "max 100"
    },
    {
      "field": "reportingPeriodStart",
      "value": null,
      "rule": "required"
    },
    {
      "field": "reportingPeriodEnd",
      "value": "2026-03-31",
      "rule": "end >= start (cross-field)"
    },
    {
      "field": "orgId",
      "value": null,
      "rule": "required"
    },
    {
      "field": "sourceId",
      "value": "99999999-9999-4999-8999-999999999999",
      "rule": "active data source"
    },
    {
      "field": "evidenceFileIds",
      "value": [
        "99999999-9999-4999-8999-999999999999"
      ],
      "rule": "existing file"
    },
    {
      "field": "currency",
      "value": "USD",
      "rule": "currency metrics only"
    },
    {
      "field": "reportingPeriodEnd",
      "value": "{yyyy}-03-31",
      "rule": "end >= start (cross-field)"
    },
    {
      "field": "notes",
      "value": {
        "$repeat": [
          "x",
          1001
        ]
      },
      "rule": "max 1000"
    },
    {
      "field": "ownerUserId",
      "value": "b0000000-0000-4000-8000-0000000000b1",
      "rule": "active user of the tenant"
    }
  ],
  "update": {
    "method": "PUT",
    "path": "/v1/data/points/{id}",
    "versioned": true
  },
  "changes": {
    "orgId": "{ORG_HQ}",
    "metricKey": "petrol_litres",
