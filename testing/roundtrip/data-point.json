{
  "id": "data-point",
  "forms": [
    "Data Collection Form"
  ],
  "actor": "ESG_DIRECTOR",
  "readOnlyRole": "AUDITOR",
  "create": {
    "method": "POST",
    "path": "/v1/data/points"
  },
  "read": {
    "path": "/v1/data/points/{id}"
  },
  "isolation": {
    "status": 404
  },
  "values": {
    "orgId": "{ORG_SITE_1}",
    "metricKey": "diesel_litres",
