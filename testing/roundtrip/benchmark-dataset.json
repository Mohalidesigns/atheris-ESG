    "publisher": "Manufacturers Association of Nigeria",
    "publicationYear": 2025,
    "sourceUrl": "https://example.org/survey",
    "sectorCode": "C",
    "countryCode": "NG",
    "sourceFileId": "{FILE_A}",
    "notes": "Members' 2024 returns",
    "status": "active",
    "values": [
      {
        "metricKey": "employee_turnover_pct",
        "dataYear": 2024,
        "p25": 5,
        "median": 9.5,
        "p75": 14,
        "sampleSize": 42
      }
    ]
  },
  "changes": {
    "name": "RT survey revised {u}",
