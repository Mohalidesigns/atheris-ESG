{
  "id": "benchmark-dataset",
  "forms": [
    "Benchmark dataset"
  ],
  "actor": "ESG_DIRECTOR",
  "readOnlyRole": "AUDITOR",
  "create": {
    "method": "POST",
    "path": "/v1/analytics/benchmark-datasets"
  },
  "read": {
    "path": "/v1/analytics/benchmark-datasets/{id}"
  },
  "update": {
    "method": "PUT",
    "path": "/v1/analytics/benchmark-datasets/{id}",
    "versioned": true
  },
  "isolation": {
    "status": 403,
    "note": "tenant B's plan doesn't include ESG Analytics"
  },
  "values": {
