      },
      {
        "metricKey": "employee_turnover_pct",
        "dataYear": 2025,
        "p25": 4,
        "median": 8,
        "p75": 12,
        "sampleSize": null
      }
    ]
  },
  "invalid": [
    {
      "field": "name",
      "value": "",
      "rule": "required"
    },
    {
      "field": "publisher",
      "value": "",
      "rule": "required"
    },
    {
      "field": "publicationYear",
      "value": 1999,
      "rule": "2000 to 2100"
    },
    {
      "field": "sourceUrl",
      "value": "ftp://example.org",
      "rule": "http(s) link"
    },
    {
      "field": "sectorCode",
      "value": "ZZ",
      "rule": "catalogue sector"
    },
    {
      "field": "countryCode",
      "value": "NGA",
      "rule": "2-letter code"
    },
    {
      "field": "sourceFileId",
      "value": null,
      "rule": "required"
    },
    {
      "field": "notes",
      "value": {
        "$repeat": [
          "x",
          1001
        ]
      },
      "rule": "max 1000"
    },
    {
      "field": "status",
      "value": "draft",
      "rule": "enum"
    },
    {
      "field": "values",
      "value": [],
      "rule": "at least one value"
    },
    {
      "field": "values",
      "value": [
        {
          "metricKey": "employee_turnover_pct",
          "dataYear": 2024,
          "p25": 10,
          "median": 5,
          "p75": 14
        }
      ],
      "rule": "P25 ≤ median ≤ P75",
      "errorField": "values[0].median"
    }
