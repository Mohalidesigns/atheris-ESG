  "ui": {
    "fields": {
      "name": {
        "label": "Dataset name"
      },
      "publisher": {
        "label": "Publisher"
      },
      "publicationYear": {
        "label": "Publication year"
      },
      "sourceUrl": {
        "label": "Source link (optional)"
      },
      "sectorCode": {
        "label": "Sector (optional)",
        "kind": "select",
        "display": "C · Manufacturing"
      },
      "countryCode": {
        "label": "Country (optional)"
      },
      "sourceFileId": {
        "label": "Source document",
        "kind": "text",
        "display": "evidence.pdf"
      },
      "notes": {
        "label": "Notes (optional)"
      },
      "status": {
        "label": "Status",
        "kind": "select",
        "display": "Active"
      },
      "values": {
        "kind": "rows",
        "columns": {
          "metricKey": {
            "label": "Metric",
            "kind": "select",
            "options": {
              "employee_turnover_pct": "Employee turnover rate (%)",
              "women_in_management_pct": "Women in management (%)"
            }
          },
          "dataYear": {
            "label": "Data year"
          },
          "p25": {
            "label": "P25"
          },
          "median": {
            "label": "Median"
          },
          "p75": {
            "label": "P75"
          },
          "sampleSize": {
            "label": "Sample size"
          }
        }
      }
    }
  }
