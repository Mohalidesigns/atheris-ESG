# Copy to deploy/vps/.env on the VPS (chmod 600; never commit it) and replace every CHANGE_ME.
# The backend refuses to start under the prod profile with any committed development value.
PUBLIC_URL=https://esg.atherislimited.com
PUBLIC_HOST=esg.atherislimited.com

# Host PostgreSQL 17 roles (created in deploy/vps/README.md step 3):  openssl rand -base64 24 | tr -d '/+='
ESG_OWNER_PASSWORD=CHANGE_ME
ESG_APP_PASSWORD=CHANGE_ME

# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=CHANGE_ME
# openssl rand -hex 24  (shared by backend and AI service)
ESG_AI_TOKEN=CHANGE_ME
OLLAMA_MODEL=granite4:micro
# Leave empty to switch AI features off (they then say "not configured"); default is the local AI service.
# ESG_AI_URL=

# MinIO on 127.0.0.1:9010 (evidence files). User: any name; password: openssl rand -base64 32 | tr -d '/+='
MINIO_ROOT_USER=esg-files
MINIO_ROOT_PASSWORD=CHANGE_ME
# esg-key:$(openssl rand -base64 32)   — back this up with the database: without it the files can't be read.
MINIO_KMS_SECRET_KEY=CHANGE_ME
S3_BUCKET=atheris-esg-files
S3_REGION=af-south-1

# Email (optional; in-app notifications work without it). 465 → SMTP_SSL=true, 587 → SMTP_STARTTLS=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=true
MAIL_FROM=no-reply@atherislimited.com
MAIL_ALWAYS_TO=
ESG_INTEGRATION_REQUESTS_EMAIL=

# SMS via Africa's Talking (optional; the sandbox URL shows as "Sandbox" under Integrations).
AT_USERNAME=sandbox
AT_API_KEY=
AT_URL=https://api.sandbox.africastalking.com/version1/messaging

# First start only: the platform administrator. Remove both after the first sign-in, then redeploy.
ESG_BOOTSTRAP_ADMIN_EMAIL=
ESG_BOOTSTRAP_ADMIN_PASSWORD=
ESG_BOOTSTRAP_ORGANISATION=Atheris Limited
