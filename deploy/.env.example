# WP-54: copy to deploy/.env (never commit it) and replace every CHANGE_ME with values from your secrets manager.
# The backend refuses to start under the prod profile with any value committed for local development or tests.
PUBLIC_URL=https://esg.example.org
HTTP_PORT=8080

POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
ESG_OWNER_PASSWORD=CHANGE_ME
ESG_APP_PASSWORD=CHANGE_ME

# At least 32 random bytes each:  openssl rand -base64 48   /   DATA_ENCRYPTION_KEY: openssl rand -base64 32
JWT_SECRET=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME
# Shared between the backend and the AI service; at least 24 characters:  openssl rand -hex 24
ESG_AI_TOKEN=CHANGE_ME
OLLAMA_MODEL=granite4:micro

# S3-compatible storage for evidence files (server-side encryption on).
S3_ENDPOINT=
S3_REGION=af-south-1
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Email (optional: in-app notifications work without it).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 465 = implicit TLS (SMTP_SSL=true); 587 = STARTTLS (SMTP_STARTTLS=true).
SMTP_SSL=false
SMTP_STARTTLS=true
# Leave empty in production; in staging, every email goes to this one inbox.
MAIL_ALWAYS_TO=
MAIL_FROM=no-reply@example.org

# SMS via Africa's Talking (optional; the sandbox URL shows as "Sandbox" under Integrations).
AT_USERNAME=sandbox
AT_API_KEY=
AT_URL=https://api.sandbox.africastalking.com/version1/messaging

# First start only: the platform administrator (sets up two-factor sign-in at first login). Remove both afterwards.
ESG_BOOTSTRAP_ADMIN_EMAIL=
ESG_BOOTSTRAP_ADMIN_PASSWORD=
ESG_BOOTSTRAP_ORGANISATION=Platform operator

# WP-46 (D44): where new connector requests from clients are emailed (the platform team's inbox; needs SMTP).
ESG_INTEGRATION_REQUESTS_EMAIL=
